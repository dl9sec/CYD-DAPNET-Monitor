}

void loop()
{
    web.loop();

    reconnectWiFi();

    checkAPFallback();

    if( WiFi.status() == WL_CONNECTED )
    {
        if( !dapnetStarted )
        {
            startDapnet();
        }

        dapnet.loop();
    }

    updateStatus();

    handleMessages();

    display.loop();

    delay(10);
}
