        //display.addMessage(0, 0, "LittleFS mount error.");
    
        // Loop of death
        while(true)
        {
            delay(1000);
        }
    }

    Serial.println("LittleFS mounted.");

    // Whitelist
    whitelist.begin();

    // Webserver
    if( !web.begin(&config, &whitelist, &display) )
    {
        Serial.println("WebManager error.");
    }

    display.setWhitelistCount(whitelist.size());

    // No configuration?
    if( !config.isConfigured() )
    {
        Serial.println();
        Serial.println("No configuration found.");
        Serial.println("Starting AP...");

        web.startAP();

        apFallbackStarted = true;

        return;
    }

    // Connect to WLAN
    wifiStartupTime = millis();

    connectWiFi();

     // Prepare DAPNET
    if( WiFi.status() == WL_CONNECTED )
