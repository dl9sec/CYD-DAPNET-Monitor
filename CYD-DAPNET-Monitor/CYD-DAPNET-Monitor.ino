{
    Serial.begin(115200);
    delay(1000);
    Serial.println();
    Serial.println("=================================");
    Serial.println("CYD DAPNET Monitor v1.0");
    Serial.println("=================================");

    // CYD backlight on
    pinMode(CYD_BACKLIGHT_PIN, OUTPUT);
    digitalWrite(CYD_BACKLIGHT_PIN, HIGH);

    // Display
    display.begin();
    display.setWifiStatus(false);
    display.setDapnetStatus(false);

    // Load configuration
    if( !config.begin() )
