#include <WiFi.h>
#include <LittleFS.h>

#include "ConfigManager.h"
#include "WebManager.h"
#include "DisplayManager.h"
#include "DapnetClient.h"
#include "RicWhitelist.h"

#define CYD_BACKLIGHT_PIN          21
#define WIFI_AP_FALLBACK_TIMEOUT   60000UL

ConfigManager  config;
WebManager     web;
DisplayManager display;
DapnetClient   dapnet;
RicWhitelist   whitelist;

bool     dapnetStarted     = false;
bool     apFallbackStarted = false;
bool     lastWifiState     = false;
bool     lastDapnetState   = false;
uint32_t wifiStartupTime   = 0;


void connectWiFi()
{
    if(config.cfg.ssid.isEmpty())
    {
        return;
    }

    Serial.println();
    Serial.println("Connect to WLAN...");

    WiFi.mode(WIFI_STA);

    WiFi.begin(config.cfg.ssid.c_str(), config.cfg.password.c_str());

    uint32_t start = millis();

    while( WiFi.status() != WL_CONNECTED && millis() - start < 30000 )
    {
        Serial.print(".");
        delay(500);
    }

    Serial.println();

    if( WiFi.status() == WL_CONNECTED )
    {
        Serial.println("WLAN connected.");
        web.startSTA();
        Serial.print("Assigned IP: "); Serial.println(WiFi.localIP());
        display.setWifiStatus(true);
        display.setIPAddress(WiFi.localIP().toString());
        apFallbackStarted = false;
    }
    else
    {
        Serial.println("Connecting WLAN failed.");
        display.setWifiStatus(false);
        display.setIPAddress("---.---.---.---");
    }

}

void startDapnet()
{
    if(dapnetStarted)
    {
        return;
    }

    Serial.println();
    Serial.println("Initialize DAPNET...");

    dapnet.begin(config.cfg.host, config.cfg.port, config.cfg.callsign, config.cfg.authkey);

    dapnetStarted = true;

}

void reconnectWiFi()
{
    static uint32_t lastTry = 0;

    if( WiFi.status() == WL_CONNECTED )
    {
        return;
    }

    if( !config.isConfigured() )
    {
        return;
    }

    if( millis() - lastTry < 10000UL )
    {
        return;
    }

    lastTry = millis();

    Serial.println("Reconnecting to WLAN...");

    WiFi.disconnect();

    WiFi.begin(config.cfg.ssid.c_str(), config.cfg.password.c_str());

}

void checkAPFallback()
{
    if( apFallbackStarted )
    {
        return;
    }

    if( WiFi.status() == WL_CONNECTED )
    {
        return;
    }

    if( millis() - wifiStartupTime < WIFI_AP_FALLBACK_TIMEOUT )
    {
        return;
    }

    Serial.println();
    Serial.println("WLAN timeout.");
    Serial.println("Starting AP fallback.");

    web.startAP();

    display.addMessage(0, 0, "", "AP fallback active.");

    apFallbackStarted = true;

}

void updateStatus()
{
    bool wifiState = ( WiFi.status() == WL_CONNECTED );

    if( wifiState != lastWifiState )
    {
        display.setWifiStatus(wifiState);
        lastWifiState = wifiState;
    }

    if( wifiState )
    {
        apFallbackStarted = false;
        display.setIPAddress(WiFi.localIP().toString());
    }
    else
    {
        display.setIPAddress("---.---.---.---");
    }

    bool dapnetState = dapnet.dapnetConnected();

    if( dapnetState != lastDapnetState )
    {
        display.setDapnetStatus(dapnetState);
        lastDapnetState = dapnetState;
    }

}

void handleMessages()
{
    while( dapnet.available() )
    {
        DapnetMessage msg = dapnet.getMessage();

        if( !msg.valid )
        {
            continue;
        }

        Serial.println();
        Serial.println("==============================");
        Serial.print("RIC = "); Serial.print(msg.ric); Serial.print("  FUNC = "); Serial.println(msg.function);
        Serial.print("TEXT = "); Serial.println(msg.text);

        if( whitelist.contains(msg.ric) )
        {
            display.addMessage(msg.ric, msg.function, whitelist.getName(msg.ric), msg.text);
        }

        // Time telegram, e.g. 20261118054600
        if( msg.ric == 224 )
        {
            if( msg.text.length() >= 14 )
            {
                String hh = msg.text.substring(msg.text.length() - 6, msg.text.length() - 4);
                String mm = msg.text.substring(msg.text.length() - 4, msg.text.length() - 2);
                String ss = msg.text.substring(msg.text.length() - 2);

                String timeString = hh + ":" + mm + "." + ss;

                display.setClock(timeString);

                Serial.print("DAPNET time = "); Serial.println(timeString);
            }
        }
    }

}

